<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Regression Suite" parallel="tests" thread-count="3">

    <!-- Scenario 1: Parallel Thread 1 - Authentication Tests -->
    <test name="Login Scenario">
        <classes>
            <class name="com.saucedemo.tests.scenario1.LoginWithValidCredentialsTest"/>
        </classes>
    </test>

    <!-- Scenario 2: Parallel Thread 2 - Inventory and Product Management -->
    <test name="Home Page Scenario">
        <classes>
            <class name="com.saucedemo.tests.scenario2.HomePageTest"/>
        </classes>
    </test>

    <!-- Scenario 3: Parallel Thread 3 - End-to-End Purchase Workflow -->
    <test name="Checkout Scenario">
        <classes>
            <class name="com.saucedemo.tests.scenario2.CheckOutTest"/>
        </classes>
    </test>

</suite>